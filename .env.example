# Copy to .env to use a keyed provider. Never commit .env.
# These are optional. The defaults are the public endpoints in pipeline/ousd/chains.py.
TEMPO_RPC_URL=https://rpc.tempo.xyz
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
ETHEREUM_BLOCKSCOUT_URL=https://eth.blockscout.com/api
BRIDGE_API_URL=https://transparency.bridge.xyz/v0/stablecoins/ousd
OUSD_DB_PATH=data/ousd.duckdb
# These have no public default, so set your own provider's URL. Base and Solana ingestion will
# read them.
BASE_RPC_URL=
SOLANA_RPC_URL=
# Backups. `ousd backup` writes to OUSD_BACKUP_DIR (default data/backups). Retention keeps the
# newest copy of each of the last OUSD_BACKUP_KEEP_DAILY days with one (default 7) and of the last
# OUSD_BACKUP_KEEP_WEEKLY ISO weeks (default 4), locally and in the bucket.
OUSD_BACKUP_DIR=data/backups
OUSD_BACKUP_KEEP_DAILY=7
OUSD_BACKUP_KEEP_WEEKLY=4
# Upload to S3-compatible storage, such as s3://bucket/prefix. Unset means local copies only. The
# endpoint and region are for a provider other than AWS, such as https://s3.fr-par.scw.cloud and
# fr-par. The two credentials are secrets: set them only in .env or the host's variables.
OUSD_BACKUP_URL=
OUSD_BACKUP_ENDPOINT_URL=
OUSD_BACKUP_REGION=
OUSD_BACKUP_ACCESS_KEY_ID=
OUSD_BACKUP_SECRET_ACCESS_KEY=
# Optional alerts. Both are secrets: they are never logged and are scrubbed from errors. A failed
# run always writes data/alerts/<run_id>.json, and with the webhook set it also posts a summary
# there. With the heartbeat set, a fully successful run pings it (scripts/daily.sh: only after the
# deploy), so a dead-man check notices a run that never alerted or never started. Unset means
# nothing is sent.
OUSD_ALERT_WEBHOOK_URL=
OUSD_HEARTBEAT_URL=
# Optional limits, in seconds. Blank means the default: 10800 for the whole run, 1800 for the dbt
# build, and 3600 in total spent waiting out servers' rate limits.
OUSD_MAX_RUNTIME_SECONDS=
OUSD_DBT_TIMEOUT_SECONDS=
OUSD_RATE_LIMIT_WAIT_SECONDS=
