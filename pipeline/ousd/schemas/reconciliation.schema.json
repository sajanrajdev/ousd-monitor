{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "reconciliation.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "preview",
    "data",
    "latest_run"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "preview": {
      "type": "boolean"
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "subject",
          "block_number",
          "event_value",
          "reference_value",
          "difference",
          "passed",
          "checked_at",
          "run_id",
          "in_latest_run"
        ],
        "properties": {
          "kind": {
            "enum": [
              "chain",
              "bridge"
            ]
          },
          "subject": {
            "type": "string"
          },
          "block_number": {
            "type": [
              "integer",
              "null"
            ]
          },
          "event_value": {
            "type": "string",
            "pattern": "^-?[0-9]+$"
          },
          "reference_value": {
            "type": "string",
            "pattern": "^-?[0-9]+$"
          },
          "difference": {
            "type": "string",
            "pattern": "^-?[0-9]+$"
          },
          "passed": {
            "type": "boolean"
          },
          "checked_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "run_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "in_latest_run": {
            "type": [
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    "latest_run": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "run_id",
        "scope",
        "status",
        "finished_at"
      ],
      "properties": {
        "run_id": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "finished_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      }
    }
  }
}
