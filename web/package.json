{
  "name": "ousd-monitor-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "^22.12 || ^24"
  },
  "scripts": {
    "acceptance": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/acceptance.mjs",
    "build": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/build-site.mjs",
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings=0 .",
    "measure": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/measure-page.mjs",
    "release": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/build-site.mjs --release",
    "shots": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/shots.mjs",
    "test": "vitest run",
    "types": "NEXT_TELEMETRY_DISABLED=1 next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "marked": "18.1.3",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@tailwindcss/postcss": "4.3.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.4",
    "jsdom": "28.1.0",
    "json-schema-to-typescript": "16.0.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
